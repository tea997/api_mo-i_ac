NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
# Create free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/api_monitoring?retryWrites=true&w=majority
MONGO_DB_NAME=api_monitoring

# PostgreSQL (optional - skip if not using)
PG_HOST=
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=

# RabbitMQ (optional - skip if not using)
RABBITMQ_URL=
RABBITMQ_QUEUE=api_hits

# JWT
JWT_SECRET=your_strong_secret_here_min_32_chars
JWT_EXPIRES_IN=24h

# CORS - paste your Vercel frontend URL (no trailing slash)
# e.g. https://api-monitoring-dashboard.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
